method EQPlot(CandleSet cs) =>
    if barstate.islast and settings.eq_show and cs.candles.size() >= 2 and (settings.eq_all or cs.tfNumber == ts_target)
        Candle cur = cs.candles.get(0)
        float eq = cs.PrevEQ()
        int x1 = cur.o_idx
        int x2 = bar_index + 1
 
        if settings.eq_project and cs.nxt_bars > 0
            x2 := bar_index + cs.nxt_bars
 
        if na(cs.eq_line)
            cs.eq_line := line.new(x1, eq, x2, eq, xloc = xloc.bar_index, color = settings.eq_color, style = ls_eq, width = settings.eq_width, extend = settings.eq_extend ? extend.right : extend.none)
        else
            line.set_xy1(cs.eq_line, x1, eq)
            line.set_xy2(cs.eq_line, x2, eq)
 
        if settings.eq_label
            string txt = f_htfname(cs.settings.htf) + ' EQ ' + str.tostring(eq, format.mintick)
            if na(cs.eq_lbl)
                cs.eq_lbl := label.new(x2, eq, txt, xloc = xloc.bar_index, style = label.style_label_left, color = color_transparent, textcolor = settings.eq_label_color, size = settings.eq_label_size)
            else
                label.set_xy(cs.eq_lbl, x2, eq)
                label.set_text(cs.eq_lbl, txt)
    cs
 
method Monitor(CandleSet candleSet) =>
    bool isNewHTFCandle = settings.use_custom_daily and candleSet.settings.htf == '1D' ? cd_new : candleSet.new_ny
    candleSet.new_ex := isNewHTFCandle
 
    if isNewHTFCandle
        candleSet.imb_new := true
        candleSet.TSpotNewCandle()
 
        if candleSet.candles.size() > 0
            candleSet.candles.first().Style()
 
        Candle candle = Candle.new(open, close, high, low, time, bar_index, '', na, na, na, na, array.new<Sweep>(0), time_tradingday)
 
        candleSet.candles.unshift(candle)
 
        if candleSet.candles.size() > candleSet.settings.max_display
            Candle delCandle = candleSet.candles.pop()
 
            if not na(delCandle.body)
                box.delete(delCandle.body)
                line.delete(delCandle.wick_up)
                line.delete(delCandle.wick_down)
 
            if not na(delCandle.dow_label)
                label.delete(delCandle.dow_label)
 
            if delCandle.sweeps.size() > 0
                for i = 0 to delCandle.sweeps.size() - 1
                    Sweep sw = delCandle.sweeps.get(i)
                    if not na(sw.htf_marker)
                        line.delete(sw.htf_marker)
                delCandle.sweeps.clear()
 
        if settings.show_sep and sep_target == candleSet.tfNumber
            line new_separator = line.new(x1=bar_index, x2=bar_index, y1=high + syminfo.mintick, y2=low - syminfo.mintick, extend=extend.both, color=settings.sep_color, style=ls_sep, width=settings.sep_width)
            separators.push(new_separator)
 
            if separators.size() > candleSet.settings.max_display
                line.delete(separators.shift())
 
    candleSet
 
method NextOpen(CandleSet candleSet) =>
    if barstate.islast and settings.show_sep and settings.sep_next and sep_target == candleSet.tfNumber and candleSet.nxt_bars > 0
        int x = bar_index + candleSet.nxt_bars
        if na(candleSet.next_sep)
            candleSet.next_sep := line.new(x, high + syminfo.mintick, x, low - syminfo.mintick, xloc = xloc.bar_index, extend = extend.both, color = settings.sep_next_color, style = line.style_dashed, width = settings.sep_width)
        else
            line.set_xy1(candleSet.next_sep, x, high + syminfo.mintick)
            line.set_xy2(candleSet.next_sep, x, low - syminfo.mintick)
    candleSet
 
method Update(CandleSet candleSet, int offset) =>
    if candleSet.candles.size() > 0
        Candle candle = candleSet.candles.first()
        candle.h := math.max(high, candle.h)
        candle.l := math.min(low, candle.l)
        candle.c := close
        if draw_now
            candle.Style()
            candleSet.Reorder(offset)
    candleSet
 
