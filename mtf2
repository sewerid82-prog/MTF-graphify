f_tspot_draw(bool is_bull, bool is_c4, float eq, bool failed) =>
    float top = math.max(open, eq)
    float bot = math.min(open, eq)
    box bx = na
    if not failed
        bx := box.new(bar_index, top, bar_index, bot, border_color = na, bgcolor = is_bull ? settings.tspot_bull : settings.tspot_bear)
    line dash = line.new(bar_index, eq, bar_index, eq, color = failed ? color.red : settings.tspot_line, width = 1, style = line.style_dotted)
    label lbl = na
    if settings.tspot_label
        string base = is_c4 ? 'C4' : 'C3'
        lbl := label.new(bar_index + 2, eq, (failed ? 'X' : '') + base, xloc = xloc.bar_index, style = is_bull ? label.style_label_up : label.style_label_down, color = color_transparent, textcolor = failed ? color.red : settings.tspot_label_color, size = settings.tspot_label_size)
    [bx, dash, lbl]
 
method TSpotClear(TSpot t) =>
    if not na(t.c3_box)
        box.delete(t.c3_box)
        t.c3_box := na
    if not na(t.c3_dash)
        line.delete(t.c3_dash)
        t.c3_dash := na
    if not na(t.c3_lbl)
        label.delete(t.c3_lbl)
        t.c3_lbl := na
    if not na(t.c4_box)
        box.delete(t.c4_box)
        t.c4_box := na
    if not na(t.c4_dash)
        line.delete(t.c4_dash)
        t.c4_dash := na
    if not na(t.c4_lbl)
        label.delete(t.c4_lbl)
        t.c4_lbl := na
    t
 
method TSpotFail(TSpot t) =>
    if t.phase == 1
        t.c3_invalid := true
        if not na(t.c3_lbl)
            label.set_text(t.c3_lbl, 'XC3')
            label.set_textcolor(t.c3_lbl, color.red)
        if not na(t.c3_dash)
            line.set_color(t.c3_dash, color.red)
        if not na(t.c3_box)
            box.delete(t.c3_box)
            t.c3_box := na
    else if t.phase == 2
        t.c4_invalid := true
        if not na(t.c4_lbl)
            label.set_text(t.c4_lbl, 'XC4')
            label.set_textcolor(t.c4_lbl, color.red)
        if not na(t.c4_dash)
            line.set_color(t.c4_dash, color.red)
        if not na(t.c4_box)
            box.delete(t.c4_box)
            t.c4_box := na
    t
 
// Opens a new T-Spot (C3 zone) from the just-closed C2 candle x.
method TSpotAdd(CandleSet cs, Candle x, bool is_bull) =>
    float c2_eq = f_c2_eq(is_bull, x.o, x.c, x.h, x.l)
    bool c3_failed = is_bull ? open < c2_eq : open > c2_eq
    TSpot nt = TSpot.new(is_bull, is_bull ? x.l : x.h)
    [bx, dash, lbl] = f_tspot_draw(is_bull, false, c2_eq, c3_failed)
    nt.c3_box := bx
    nt.c3_dash := dash
    nt.c3_lbl := lbl
    nt.c3_eq := c2_eq
    nt.c3_invalid := c3_failed
    cs.tspots.push(nt)
    while cs.tspots.size() > settings.tspot_history
        TSpot old = cs.tspots.shift()
        old.TSpotClear()
    cs
 
method TSpotNewCandle(CandleSet cs) =>
    if settings.tspot_show and cs.tfNumber == ts_target
        if cs.candles.size() > 0
            Candle x = cs.candles.first()
 
            for t in cs.tspots
                if not t.dead
                    if t.phase == 1
                        if not t.c3_invalid
                            if not na(t.c3_box)
                                box.set_right(t.c3_box, bar_index)
                            if not na(t.c3_dash)
                                line.set_x2(t.c3_dash, bar_index)
                            float c3_eq = (x.h + x.l) / 2
                            bool c4_failed = t.is_bull ? open < c3_eq : open > c3_eq
                            [bx, dash, lbl] = f_tspot_draw(t.is_bull, true, c3_eq, c4_failed)
                            t.c4_box := bx
                            t.c4_dash := dash
                            t.c4_lbl := lbl
                            t.c4_eq := c3_eq
                            t.c4_invalid := c4_failed
                            t.phase := 2
                        else
                            t.phase := 0
                    else if t.phase == 2
                        if not t.c4_invalid
                            if not na(t.c4_box)
                                box.set_right(t.c4_box, bar_index)
                            if not na(t.c4_dash)
                                line.set_x2(t.c4_dash, bar_index)
                        t.phase := 0
 
            if not na(cs.prev_h) and not na(cs.prev_l)
                if x.l < cs.prev_l and x.c > cs.prev_l and settings.bias != "Bearish"
                    cs.TSpotAdd(x, true)
                if x.h > cs.prev_h and x.c < cs.prev_h and settings.bias != "Bullish"
                    cs.TSpotAdd(x, false)
 
            cs.prev_h := x.h
            cs.prev_l := x.l
    cs
 
method TSpotUpdate(CandleSet cs) =>
    if settings.tspot_show and cs.tfNumber == ts_target
        if cs.tspots.size() > 0
            for i = cs.tspots.size() - 1 to 0
                TSpot t = cs.tspots.get(i)
                if t.phase != 0 and not t.dead
                    bool live_invalid = t.phase == 1 ? t.c3_invalid : t.c4_invalid
 
                    if not live_invalid
                        if t.phase == 1
                            if not na(t.c3_box)
                                box.set_right(t.c3_box, bar_index)
                            if not na(t.c3_dash)
                                line.set_x2(t.c3_dash, bar_index)
                        else
                            if not na(t.c4_box)
                                box.set_right(t.c4_box, bar_index)
                            if not na(t.c4_dash)
                                line.set_x2(t.c4_dash, bar_index)
 
                    bool breach = t.is_bull ? low < t.extreme : high > t.extreme
                    if breach
                        t.TSpotClear()
                        t.dead := true
                        t.phase := 0
                        cs.tspots.remove(i)
                    else if not live_invalid
                        float eq = t.phase == 1 ? t.c3_eq : t.c4_eq
                        bool broke = false
                        if settings.tspot_inval == 'Close through EQ'
                            broke := t.is_bull ? close < eq : close > eq
                        else
                            broke := t.is_bull ? low < eq : high > eq
                        if broke
                            t.TSpotFail()
    cs
 
// Time of the next HTF open. Monthly uses the exact next NY month start; others use open + HTF length.
f_next_open(CandleSet cs) =>
    int o = cs.candles.first().o_time
    int nx = o + cs.htf_ms
    if cs.htf_ms >= 2592000000
        int mid = o + 1296000000
        int y = year(mid, TZ_NY)
        int m = month(mid, TZ_NY)
        nx := timestamp(TZ_NY, m == 12 ? y + 1 : y, m == 12 ? 1 : m + 1, 1, 0, 0)
    nx
 
// Bars until the next HTF open (last bar only). Skips a Saturday open on markets with no Saturday bars; weekly+ is scaled 5/7 there.
method CalcNext(CandleSet cs) =>
    cs.nxt_bars := 0
    if barstate.islast and cs.candles.size() > 0
        bool is_t = cs.tfNumber == ts_target
        bool need_ts = settings.tspot_show and is_t
        bool need_eq = settings.eq_show and cs.candles.size() >= 2 and (settings.eq_all or is_t)
        bool need_sep = settings.show_sep and settings.sep_next and sep_target == cs.tfNumber
        bool need_cf = (cf_fvg or cf_vi) and is_t
        if need_ts or need_eq or need_sep or need_cf
            int nx = f_next_open(cs)
            if has_sat or dayofweek(nx, TZ_NY) != dayofweek.saturday
                int bars = math.round((nx - time) / 1000.0 / tf_sec)
                if not has_sat and cs.htf_ms >= 604800000
                    bars := math.round(bars * 5.0 / 7.0)
                if bars > 0 and bars <= 500
                    cs.nxt_bars := bars
    cs
    
method TSpotProject(CandleSet cs) =>
    if barstate.islast and settings.tspot_show and cs.tfNumber == ts_target and cs.nxt_bars > 0
        int x = bar_index + cs.nxt_bars
        for t in cs.tspots
            if not t.dead
                if t.phase == 1 and not t.c3_invalid
                    if not na(t.c3_box)
                        box.set_right(t.c3_box, x)
                    if not na(t.c3_dash)
                        line.set_x2(t.c3_dash, x)
                else if t.phase == 2 and not t.c4_invalid
                    if not na(t.c4_box)
                        box.set_right(t.c4_box, x)
                    if not na(t.c4_dash)
                        line.set_x2(t.c4_dash, x)
    cs
 
