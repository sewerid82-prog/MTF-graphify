var array<line>  hbslLines  = array.new<line>()
var array<label> hbslLabels = array.new<label>()
var array<float> hbslPrices = array.new<float>()
var array<bool>  hbslSwept  = array.new<bool>()
var array<line>  hsslLines  = array.new<line>()
var array<label> hsslLabels = array.new<label>()
var array<float> hsslPrices = array.new<float>()
var array<bool>  hsslSwept  = array.new<bool>()

// Same HTF as T-Spot (first enabled valid HTF).
string liq_htf = liqHtfShow and ts_target > 0 ? ts_htf : timeframe.period
string liq_nm = f_htfname(liq_htf)
bool liqHtfOn = liq_htf != timeframe.period

// HTF liquidity window (wider than win_bars so older HTF levels still show)
bool in_winH = last_bar_index - bar_index <= win_bars * 4

// chart-timeframe pivots (only evaluated inside the window)
float liqPivotHigh = liqShow and in_win ? ta.pivothigh(high, liqSwingLen, liqSwingLen) : na
float liqPivotLow  = liqShow and in_win ? ta.pivotlow(low, liqSwingLen, liqSwingLen) : na
int   liqPivotBar  = bar_index - liqSwingLen

// HTF pivots built from chart bars (no request.security): ring of the last 2*len+1 completed HTF candles. Uses NY clock like the candles.
var array<int>   hq_s = array.new<int>()
var array<float> hq_h = array.new<float>()
var array<float> hq_l = array.new<float>()
var int   hc_s = na
var float hc_h = na
var float hc_l = na
bool h_chg = f_chg_ny(liq_htf, liqHtfOn and in_winH)
float hPivotHigh = na
float hPivotLow  = na
int   hPivotBar  = na
if barstate.isconfirmed and liqHtfOn and in_winH
    if h_chg
        if not na(hc_s)
            hq_s.push(hc_s)
            hq_h.push(hc_h)
            hq_l.push(hc_l)
            int n2 = 2 * liqHtfLen + 1
            if hq_s.size() > n2
                hq_s.shift()
                hq_h.shift()
                hq_l.shift()
            if hq_s.size() == n2
                float mh = hq_h.get(liqHtfLen)
                float ml = hq_l.get(liqHtfLen)
                bool isPh = true
                bool isPl = true
                for i = 0 to n2 - 1
                    if i != liqHtfLen
                        float hv = hq_h.get(i)
                        float lv = hq_l.get(i)
                        if i < liqHtfLen
                            if hv >= mh
                                isPh := false
                            if lv <= ml
                                isPl := false
                        else
                            if hv > mh
                                isPh := false
                            if lv < ml
                                isPl := false
                if isPh
                    hPivotHigh := mh
                if isPl
                    hPivotLow := ml
                hPivotBar := hq_s.get(liqHtfLen)
        hc_s := bar_index
        hc_h := high
        hc_l := low
    else if not na(hc_s)
        hc_h := math.max(hc_h, high)
        hc_l := math.min(hc_l, low)

addLiqLine(array<line> lns, array<label> lbs, array<float> prices, array<bool> swept, float price, int pBar, string txt, color clr, string sty, int wd) =>
    string lblText = liqShowPrice ? txt + ' (' + str.tostring(price, format.mintick) + ')' : txt
    bool isBslTxt = str.endswith(txt, 'BSL')
    ln = line.new(pBar, price, bar_index, price, xloc.bar_index, extend.none, clr, f_ls(sty), wd)
    lb = liqShowLabel ? label.new(bar_index, price, lblText, xloc = xloc.bar_index, style = isBslTxt ? label.style_label_down : label.style_label_up, color = color_transparent, textcolor = clr, size = liqLabelSize) : na
    lns.push(ln)
    lbs.push(lb)
    prices.push(price)
    swept.push(false)
    while lns.size() > liqMaxLines
        line.delete(lns.shift())
        oldLbl = lbs.shift()
        if not na(oldLbl)
            label.delete(oldLbl)
        prices.shift()
        swept.shift()

// Unswept lines are only stretched on the last bar; a sweep fixes the end at the sweep bar.
updateLiqLines(array<line> lns, array<label> lbs, array<float> prices, array<bool> swept, bool isBsl) =>
    if lns.size() > 0
        for i = lns.size() - 1 to 0
            if swept.get(i)
                continue
            price = prices.get(i)
            bool breached = isBsl ? high >= price : low <= price
            if breached
                if liqRemoveSwept
                    ln_ref = lns.get(i)
                    lb_ref = lbs.get(i)
                    lns.remove(i)
                    lbs.remove(i)
                    prices.remove(i)
                    swept.remove(i)
                    line.delete(ln_ref)
                    if not na(lb_ref)
                        label.delete(lb_ref)
                else
                    swept.set(i, true)
                    line.set_x2(lns.get(i), bar_index)
                    lb = lbs.get(i)
                    if not na(lb)
                        label.set_x(lb, bar_index)
            else if barstate.islast
                line.set_x2(lns.get(i), bar_index)
                lb = lbs.get(i)
                if not na(lb)
                    label.set_x(lb, bar_index)

if in_win and liqShow
    updateLiqLines(bslLines, bslLabels, bslPrices, bslSwept, true)
    updateLiqLines(sslLines, sslLabels, sslPrices, sslSwept, false)

// HTF pivots are added before the HTF sweep check so the bar that confirms them is also checked.
if barstate.isconfirmed and not na(hPivotHigh)
    addLiqLine(hbslLines, hbslLabels, hbslPrices, hbslSwept, hPivotHigh, hPivotBar, liq_nm + ' BSL', liqHtfColor, liqHtfStyleStr, liqHtfWidth)

if barstate.isconfirmed and not na(hPivotLow)
    addLiqLine(hsslLines, hsslLabels, hsslPrices, hsslSwept, hPivotLow, hPivotBar, liq_nm + ' SSL', liqHtfColor, liqHtfStyleStr, liqHtfWidth)

if liqHtfOn and in_winH
    updateLiqLines(hbslLines, hbslLabels, hbslPrices, hbslSwept, true)
    updateLiqLines(hsslLines, hsslLabels, hsslPrices, hsslSwept, false)

if liqShow and in_win and barstate.isconfirmed and not na(liqPivotHigh)
    addLiqLine(bslLines, bslLabels, bslPrices, bslSwept, liqPivotHigh, liqPivotBar, 'BSL', liqColor, liqStyleStr, liqWidth)

if liqShow and in_win and barstate.isconfirmed and not na(liqPivotLow)
    addLiqLine(sslLines, sslLabels, sslPrices, sslSwept, liqPivotLow, liqPivotBar, 'SSL', liqColor, liqStyleStr, liqWidth)
    
