f_tbl_pos(string p) =>
    switch p
        'Top Left'      => position.top_left
        'Top Center'    => position.top_center
        'Top Right'     => position.top_right
        'Middle Left'   => position.middle_left
        'Middle Center' => position.middle_center
        'Middle Right'  => position.middle_right
        'Bottom Left'   => position.bottom_left
        'Bottom Center' => position.bottom_center
        => position.bottom_right
 
var table info_tbl = na
 
// ADR from tracked daily ranges (no request.security): average of the last N completed days; today = running day range.
var float adr_dh = na
var float adr_dl = na
var int   adr_rolls = 0
var array<float> adr_arr = array.new<float>()
if settings.tbl_show and settings.tbl_adr
    if pd_nw_d or na(adr_dh)
        adr_rolls += 1
        if adr_rolls > 2
            adr_arr.push(adr_dh - adr_dl)
            if adr_arr.size() > adr_len_in
                adr_arr.shift()
        adr_dh := high
        adr_dl := low
    else
        adr_dh := math.max(adr_dh, high)
        adr_dl := math.min(adr_dl, low)

float adr = na
float adr_today = na
if settings.tbl_show and settings.tbl_adr and barstate.islast
    adr := adr_arr.size() > 0 ? adr_arr.avg() : na
    adr_today := adr_dh - adr_dl
 
if settings.tbl_show and barstate.islast
    if na(info_tbl)
        info_tbl := table.new(f_tbl_pos(settings.tbl_pos), 1, 6, bgcolor = settings.tbl_bg, border_width = 0)
 
    string tz = settings.tbl_tz == 'Exchange' ? syminfo.timezone : settings.tbl_tz
 
    string htf_str = ''
    if ts_target > 0
        htf_str := f_htfname(sets.get(ts_target - 1).settings.htf)
    string chart_str = f_htfname(timeframe.period)
    string model_txt = ts_target > 0 ? chart_str + ' - ' + htf_str + ' Model' : chart_str + ' Model'
 
    string time_fmt = settings.tbl_12h ? (settings.tbl_seconds ? 'hh:mm:ss a' : 'hh:mm a') : (settings.tbl_seconds ? 'HH:mm:ss' : 'HH:mm')
    string time_txt = str.format_time(timenow, time_fmt, tz)
    string date_txt = str.format_time(timenow, 'MMM dd yyyy', tz)
 
    table.cell(info_tbl, 0, 0, settings.tbl_ticker ? syminfo.ticker : '', text_color = settings.tbl_text, text_size = settings.tbl_size, text_halign = text.align_center)
    table.cell(info_tbl, 0, 1, settings.tbl_model ? model_txt : '', text_color = settings.tbl_text, text_size = settings.tbl_size, text_halign = text.align_center)
    table.cell(info_tbl, 0, 2, settings.tbl_time ? time_txt : '', text_color = settings.tbl_text, text_size = settings.tbl_size, text_halign = text.align_center)
    table.cell(info_tbl, 0, 3, settings.tbl_date ? date_txt : '', text_color = settings.tbl_text, text_size = settings.tbl_size, text_halign = text.align_center)
    string adr_txt = settings.tbl_adr and not na(adr) ? 'ADR(' + str.tostring(adr_len_in) + '): ' + str.tostring(adr, format.mintick) : ''
    table.cell(info_tbl, 0, 4, adr_txt, text_color = settings.tbl_text, text_size = settings.tbl_size, text_halign = text.align_center)
    string adr_used_txt = settings.tbl_adr and not na(adr) and adr > 0 and not na(adr_today) ? 'ADR used: ' + str.tostring(adr_today / adr * 100, '#.#') + '%' : ''
    table.cell(info_tbl, 0, 5, adr_used_txt, text_color = settings.tbl_text, text_size = settings.tbl_size, text_halign = text.align_center)
