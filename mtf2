int offset = settings.offset
 
processHTF(CandleSet htf, int offset) =>
    htf.Monitor().TSpotUpdate().Update(offset).FindImbalance().CheckSweeps().CalcNext().NextOpen().TSpotProject().EQPlot()
 
calcOffset(CandleSet htf) =>
    candleSize = htf.candles.size()
    candleSize * (settings.width + settings.buffer) - (candleSize > 0 ? settings.buffer : 0) + settings.htf_buffer
 
for [k, cs] in active
    if f_rng(cs)
        processHTF(cs, offset)
    if k < active.size() - 1
        offset += calcOffset(cs)
 
