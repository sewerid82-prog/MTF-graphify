cxEarlyDraw(bool isBull, float level, int idx, int confirmBar) =>
    array<CxEarly> target = isBull ? cxBullEarly : cxBearEarly
    color clr = isBull ? cx_earlyBull : cx_earlyBear
    if cx_early
        ln = line.new(idx, level, confirmBar + 3, level, color = clr, style = f_ls(cx_earlyStyle), width = cx_earlyWidth)
        label lbl = na
        if cx_labels
            lbl := label.new(confirmBar + 3, level, isBull ? '+CISD' : '-CISD', xloc = xloc.bar_index, style = label.style_label_left, color = color_transparent, textcolor = clr, size = cx_lblSize)
        target.push(CxEarly.new(ln, lbl, confirmBar))
    if cx_alerts and cx_alertEarly
        alert((isBull ? 'Bullish' : 'Bearish') + ' Early CISD on ' + syminfo.ticker, alert.freq_once_per_bar)
 
cxPruneEarly(array<CxEarly> recs, int thresholdBar) =>
    if not na(thresholdBar)
        while recs.size() > 0 and recs.first().barIndex < thresholdBar
            evicted = recs.shift()
            line.delete(evicted.ln)
            if not na(evicted.lbl)
                label.delete(evicted.lbl)
 
cxConsumeEarly(array<CxEarly> recs) =>
    if recs.size() > 0
        evicted = recs.pop()
        line.delete(evicted.ln)
        if not na(evicted.lbl)
            label.delete(evicted.lbl)
 
cxConfirm(CxSetup s, int confirmBar, bool live = true) =>
    s.cisdConfirmed := true
    if live
        s.justConfirmed := true
    s.cisdEndIndex := confirmBar
    bool showLine = s.isBull ? cx_showBull : cx_showBear
    color clr     = s.isBull ? cx_bullColor : cx_bearColor
    string st     = s.isBull ? cx_bullStyle : cx_bearStyle
    int wd        = s.isBull ? cx_bullWidth : cx_bearWidth
    if showLine
        s.cisdLine := line.new(s.cisdIndex, s.cisdLevel, confirmBar + 3, s.cisdLevel, color = clr, style = f_ls(st), width = wd)
    s
 
icClearPending(CxSetup s) =>
    s.icPending      := false
    s.icLevel        := na
    s.icStartIndex   := na
    s.icExtreme      := na
    s.icExtremeIndex := na
    s
 
// Walks back from the extreme bar through consecutive opposing candles (max 50 bars, extreme must be <= 300 bars old).
// bias: 1 = bullish candles (bearish setups), -1 = bearish candles (bullish setups)
icFindCisdLevel(int extremeBarIdx, int bias) =>
    int   offs       = bar_index - extremeBarIdx
    float cisdPrice  = na
    int   cisdIdx    = na
    bool  foundFirst = false
    if offs <= 300
        for i = offs to math.min(offs + 50, bar_index)
            float cOpen  = open[i]
            float cClose = close[i]
            int   att    = cClose > cOpen ? 1 : cClose < cOpen ? -1 : 0
            if att == 0
                continue
            if not foundFirst
                if att == bias
                    foundFirst := true
                    cisdPrice  := cOpen
                    cisdIdx    := bar_index - i
            else
                if att != bias
                    break
                cisdPrice := cOpen
                cisdIdx   := bar_index - i
    [cisdPrice, cisdIdx]
 
icRetrace(CxSetup s) =>
    [lvl, lvlIdx] = icFindCisdLevel(s.icExtremeIndex, s.isBull ? -1 : 1)
    if not na(lvl)
        s.icLevel      := lvl
        s.icStartIndex := lvlIdx
    s
 
// 3-candle swing: middle bar's wick beyond (or equal to) both neighbours. Returns the most extreme one in range (scan limited to the last 300 bars).
icFindSwingRange(CxSetup s, int startIdx, int endIdx) =>
    float bestPx  = na
    int   bestIdx = na
    int   s0      = na(startIdx) ? na : math.max(startIdx, bar_index - 300)
    if not na(s0) and not na(endIdx) and endIdx > s0
        for m = s0 to endIdx - 1
            if m >= 1
                offM = bar_index - m
                offL = bar_index - (m - 1)
                offR = bar_index - (m + 1)
                if offM >= 0 and offL >= 0 and offR >= 0
                    if s.isBull
                        if low[offM] <= low[offL] and low[offM] <= low[offR]
                            if na(bestPx) or low[offM] < bestPx
                                bestPx  := low[offM]
                                bestIdx := m
                    else
                        if high[offM] >= high[offL] and high[offM] >= high[offR]
                            if na(bestPx) or high[offM] > bestPx
                                bestPx  := high[offM]
                                bestIdx := m
    [bestPx, bestIdx]
 
icMarkTaken(CxSetup s, int m) =>
    if not na(s) and not na(s.icList) and s.icList.size() > 0
        int off = bar_index - m
        if off >= 0
            for ic in s.icList
                if not ic.taken and not na(ic.extremePrice)
                    bool sweep = s.isBull ? low[off] < ic.extremePrice : high[off] > ic.extremePrice
                    if sweep
                        ic.taken := true
                        if not na(ic.dotLbl)
                            label.set_textcolor(ic.dotLbl, color.gray)
    s
 
registerIcCisd(CxSetup s, float swPx, int swIdx) =>
    color clr     = s.isBull ? cx_bullColor : cx_bearColor
    label dotLbl  = label.new(swIdx, swPx, '●', xloc = xloc.bar_index, style = s.isBull ? label.style_label_up : label.style_label_down, color = color_transparent, textcolor = clr, size = cx_icSize)
    ic = ICCisd.new(swPx, false, dotLbl, s.isBull)
    if na(s.icList)
        s.icList := array.new<ICCisd>()
    s.icList.push(ic)
    icDots.push(ic)
 
// Greys a dot when price wicks beyond its extreme, then deletes it icGreyBars bars later.
icMarkTakenAll() =>
    if icDots.size() > 0
        for i = icDots.size() - 1 to 0
            ic = icDots.get(i)
            if not ic.taken and not na(ic.extremePrice)
                bool sweep = ic.isBull ? low < ic.extremePrice : high > ic.extremePrice
                if sweep
                    ic.taken := true
                    if not na(ic.dotLbl)
                        label.set_textcolor(ic.dotLbl, color.gray)
            if ic.taken
                if na(ic.takenBar)
                    ic.takenBar := bar_index
                if bar_index - ic.takenBar >= icGreyBars
                    if not na(ic.dotLbl)
                        label.delete(ic.dotLbl)
                    icDots.remove(i)
 
// One step of the IC state machine for bar m (m == bar_index live, m < bar_index when replaying).
icStep(CxSetup s, int m, bool live) =>
    int   off    = bar_index - m
    float o_m    = open[off]
    float c_m    = close[off]
    float h_m    = high[off]
    float l_m    = low[off]
    bool  oppBar = s.isBull ? c_m < o_m : c_m > o_m
 
    if s.icPending
        bool newExt = s.isBull ? l_m < s.icExtreme : h_m > s.icExtreme
        if newExt
            s.icExtreme      := s.isBull ? l_m : h_m
            s.icExtremeIndex := m
            icRetrace(s)
        if m > s.icExtremeIndex and not na(s.icLevel)
            bool broke = s.isBull ? c_m > s.icLevel : c_m < s.icLevel
            if broke
                [swPx, swIdx] = icFindSwingRange(s, s.icStartIndex, m)
                if not na(swPx) and not na(swIdx)
                    registerIcCisd(s, swPx, swIdx)
                    icClearPending(s)
                    if live and cx_alerts and cx_alertIc
                        alert((s.isBull ? 'Bullish' : 'Bearish') + ' IC-CISD confirmed on ' + syminfo.ticker, alert.freq_once_per_bar)
                else if not newExt
                    icClearPending(s)
    else if oppBar
        s.icPending      := true
        s.icLevel        := o_m
        s.icStartIndex   := m
        s.icExtreme      := s.isBull ? l_m : h_m
        s.icExtremeIndex := m
    s
 
// Replays the step function over bars that already happened (CISD confirmed inside C2, before the setup existed).
icReplay(CxSetup s, int lastBar) =>
    if cx_ic and s.cisdConfirmed and not na(s.cisdEndIndex)
        int firstBar = math.max(s.cisdEndIndex + 1, bar_index - icBackfillMaxBars)
        if lastBar >= firstBar
            for m = firstBar to lastBar
                icMarkTaken(s, m)
                icStep(s, m, false)
    s
 
// Wick beyond the C3 extreme during C4+ stops IC detection.
icCheckC4Wick(CxSetup s) =>
    if not s.icStopped and s.phase == 2 and not na(s.c3Extreme)
        if s.isBull ? low < s.c3Extreme : high > s.c3Extreme
            s.icStopped := true
    s
 
icHardStop(CxSetup s) =>
    s.dead or s.phase == 0 or s.c4Invalid or s.icStopped
 
icUpdate(CxSetup s) =>
    if not na(s)
        icCheckC4Wick(s)
        if icHardStop(s) or not cx_ic or not s.cisdConfirmed or na(s.cisdEndIndex)
            icClearPending(s)
        else if barstate.isconfirmed and bar_index > s.cisdEndIndex
            icStep(s, bar_index, true)
    s
 
cxRegister(CxSetup s) =>
    cxRecords.push(CxRecord.new(s, bar_index))
    while cx_history > 0 and cxRecords.size() > cx_history
        evicted = cxRecords.shift()
        evicted.setup.dead      := true
        evicted.setup.phase     := 0
        evicted.setup.icStopped := true
        if not na(evicted.setup.cisdLine)
            line.delete(evicted.setup.cisdLine)
    int earliest = cxRecords.size() > 0 ? cxRecords.first().creationBar : na
    cxPruneEarly(cxBullEarly, earliest)
    cxPruneEarly(cxBearEarly, earliest)
 
cxNewSetup(bool isBull, float extreme, float cisdLevel, int cisdIndex, bool alreadyConf, int confBar) =>
    s = CxSetup.new(isBull, extreme)
    s.cisdLevel := cisdLevel
    s.cisdIndex := cisdIndex
    if alreadyConf and not na(cisdLevel) and not na(cisdIndex) and not na(confBar)
        cxConfirm(s, confBar, false)
        icReplay(s, bar_index - 1)
    cxRegister(s)
    s
 
// prevC = HTF candle that just closed (C3 for stage 4, C4 for stage 5, ...)
cxAdvance(CxSetup s, Candle prevC) =>
    if s.phase == 1
        s.c3Extreme := s.isBull ? prevC.l : prevC.h
        s.phase     := 2
        s.stage     := 4
        s.c4Invalid := false
        float mid = (prevC.h + prevC.l) / 2
        s.c4Top    := math.max(open, mid)
        s.c4Bottom := math.min(open, mid)
    else if s.phase == 2
        if not s.c4Invalid and s.stage < cx_maxCandle
            s.stage    += 1
            s.c4Invalid := false
            float mid = (prevC.h + prevC.l) / 2
            s.c4Top    := math.max(open, mid)
            s.c4Bottom := math.min(open, mid)
        else
            s.phase := 0
    s
 
cxCheckBreach(CxSetup s) =>
    if not na(s) and not s.dead and s.phase != 0
        if s.isBull ? low < s.extreme : high > s.extreme
            s.dead  := true
            s.phase := 0
    s
 
cxCheckInvalid(CxSetup s) =>
    if not na(s) and not s.dead and s.phase == 2 and not s.c4Invalid
        if s.isBull ? close[1] < s.c4Bottom : close[1] > s.c4Top
            s.c4Invalid := true
    s
 
cxCheckConfirm(CxSetup s) =>
    if barstate.isconfirmed and not na(s) and not s.dead and not s.cisdConfirmed and s.phase != 0 and not na(s.cisdLevel) and not na(s.cisdIndex)
        bool confirmed = s.isBull ? close > s.cisdLevel : close < s.cisdLevel
        if confirmed
            cxConfirm(s, bar_index)
    s
 
// ---- engine (runs on the first enabled valid HTF, inside the history window only) ----
CandleSet cx_cs = ts_target > 0 ? sets.get(ts_target - 1) : na
bool cx_ok2 = in_win and cx_show and not na(cx_cs) and cx_cs.candles.size() >= 2
bool cx_new = cx_ok2 and (settings.use_custom_daily and cx_cs.settings.htf == '1D' ? cd_new : cx_cs.new_ny)
 
bool cx_allowBuy  = settings.bias != 'Bearish'
bool cx_allowSell = settings.bias != 'Bullish'
 
bool cx_up = close > open
bool cx_dw = close < open
bool cx_eq = close == open
 
// Early-CISD level search shared by both sides. isBull: pullback candle is down, sweep is a new low. Returns [level, index].
cxFindLvl(bool isBull, float curLvl, int curIdx) =>
    float lvl = curLvl
    int   idx = curIdx
    bool  with0 = isBull ? cx_dw : cx_up
    bool  prev1 = isBull ? cx_up[1] : cx_dw[1]
    if (with0 or cx_eq) and (prev1 or cx_eq[1]) and not (cx_eq and cx_eq[1])
        lvl := open
        idx := bar_index
    else
        for i = 2 to 10
            if (isBull ? low[i] < low : high[i] > high)
                break
            bool oi = isBull ? cx_up[i] : cx_dw[i]
            bool d1 = isBull ? cx_dw[i - 1] : cx_up[i - 1]
            if (oi or cx_eq[i]) and d1
                int b = i - 1
                lvl := open[b]
                idx := bar_index - b
                for j = b to 0
                    if isBull ? (open[j] > lvl and cx_dw[j]) : (open[j] < lvl and cx_up[j])
                        lvl := open[j]
                        idx := bar_index - j
                if isBull ? lvl < open : lvl > open
                    lvl := isBull ? (close > open ? high : open) : (close < open ? low : open)
                    idx := bar_index
                break
    [lvl, idx]
 
float cx_l0 = cx_ok2 ? cx_cs.candles.get(0).l : na
float cx_h0 = cx_ok2 ? cx_cs.candles.get(0).h : na
float cx_l1 = cx_ok2 ? cx_cs.candles.get(1).l : na
float cx_h1 = cx_ok2 ? cx_cs.candles.get(1).h : na
 
if cx_ok2 and low == cx_l0 and low < cx_l1
    [bl, bi] = cxFindLvl(true, cxBullLvl, cxBullIdx)
    cxBullLvl := bl
    cxBullIdx := bi
 
if cx_ok2 and high == cx_h0 and high > cx_h1
    [sl, si] = cxFindLvl(false, cxBearLvl, cxBearIdx)
    cxBearLvl := sl
    cxBearIdx := si
 
bool cx_bullEarlyFired = false
bool cx_bearEarlyFired = false
bool cx_bullCisdFired  = false
bool cx_bearCisdFired  = false
 
bool cx_bullPeriodSweep = cx_l0 < cx_l1
bool cx_bearPeriodSweep = cx_h0 > cx_h1
 
bool cx_newBull = not na(cxBullIdx) and (na(cxBullIdx[1]) or cxBullIdx != cxBullIdx[1])
if cx_newBull
    cxBullRec    := false
    cxBullRecBar := na
if cx_ok2 and barstate.isconfirmed and not na(cxBullLvl) and not cxBullRec and close > cxBullLvl
    cxBullRec    := true
    cxBullRecBar := bar_index
    if cx_bullPeriodSweep
        cxEarlyDraw(true, cxBullLvl, cxBullIdx, bar_index)
        cx_bullEarlyFired := true
 
bool cx_newBear = not na(cxBearIdx) and (na(cxBearIdx[1]) or cxBearIdx != cxBearIdx[1])
if cx_newBear
    cxBearRec    := false
    cxBearRecBar := na
if cx_ok2 and barstate.isconfirmed and not na(cxBearLvl) and not cxBearRec and close < cxBearLvl
    cxBearRec    := true
    cxBearRecBar := bar_index
    if cx_bearPeriodSweep
        cxEarlyDraw(false, cxBearLvl, cxBearIdx, bar_index)
        cx_bearEarlyFired := true
 
// previous-bar snapshots (values at the last bar of the closed HTF candle)
float cx_bLvl1 = cxBullLvl[1]
int   cx_bIdx1 = cxBullIdx[1]
bool  cx_bRec1 = cxBullRec[1]
int   cx_bRecBar1 = cxBullRecBar[1]
float cx_sLvl1 = cxBearLvl[1]
int   cx_sIdx1 = cxBearIdx[1]
bool  cx_sRec1 = cxBearRec[1]
int   cx_sRecBar1 = cxBearRecBar[1]
 
bool cx_buyTrig  = false
bool cx_sellTrig = false
if cx_new and cx_cs.candles.size() >= 3
    Candle cx_c2 = cx_cs.candles.get(1)
    Candle cx_c1 = cx_cs.candles.get(2)
    cx_buyTrig  := cx_c2.l < cx_c1.l and cx_c2.c > cx_c1.l
    cx_sellTrig := cx_c2.h > cx_c1.h and cx_c2.c < cx_c1.h
 
if cx_buyTrig and cx_allowBuy and cx_bRec1
    cxConsumeEarly(cxBullEarly)
if cx_sellTrig and cx_allowSell and cx_sRec1
    cxConsumeEarly(cxBearEarly)
 
if cx_new
    Candle cx_prev = cx_cs.candles.get(1)
    if cx_buyTrig and cx_allowBuy
        cxBuy := cxNewSetup(true, cx_prev.l, cx_bLvl1, cx_bIdx1, cx_bRec1, cx_bRecBar1)
    else if not na(cxBuy) and not cxBuy.dead
        cxAdvance(cxBuy, cx_prev)
    if cx_sellTrig and cx_allowSell
        cxSell := cxNewSetup(false, cx_prev.h, cx_sLvl1, cx_sIdx1, cx_sRec1, cx_sRecBar1)
    else if not na(cxSell) and not cxSell.dead
        cxAdvance(cxSell, cx_prev)
 
cxCheckBreach(cxBuy)
cxCheckBreach(cxSell)
cxCheckInvalid(cxBuy)
cxCheckInvalid(cxSell)
cxCheckConfirm(cxBuy)
cxCheckConfirm(cxSell)
 
icMarkTakenAll()
 
icUpdate(cxBuy)
icUpdate(cxSell)
 
if not na(cxBuy) and cxBuy.justConfirmed
    cx_bullCisdFired := true
    cxBuy.justConfirmed := false
 
if not na(cxSell) and cxSell.justConfirmed
    cx_bearCisdFired := true
    cxSell.justConfirmed := false
 
alertcondition(cx_bullEarlyFired and cx_alerts and cx_alertEarly, title = 'Bullish Early CISD', message = 'Bullish Early CISD confirmed on {{ticker}} ({{interval}})')
alertcondition(cx_bearEarlyFired and cx_alerts and cx_alertEarly, title = 'Bearish Early CISD', message = 'Bearish Early CISD confirmed on {{ticker}} ({{interval}})')
alertcondition(cx_bullCisdFired and cx_alerts, title = 'Bullish CISD Confirmed', message = 'Bullish CISD confirmed on {{ticker}} ({{interval}})')
alertcondition(cx_bearCisdFired and cx_alerts, title = 'Bearish CISD Confirmed', message = 'Bearish CISD confirmed on {{ticker}} ({{interval}})')

