// Drawings (candle body/wicks, sweep lines) are created lazily in Reorder (draw_now only), not on history.
method Style(Candle candle) =>
    if not na(candle.body)
        bool bull = candle.c > candle.o
        box.set_bgcolor(candle.body, bull ? settings.bull_body : settings.bear_body)
        box.set_border_color(candle.body, bull ? settings.bull_border : settings.bear_border)
        line.set_color(candle.wick_up, bull ? settings.bull_wick : settings.bear_wick)
        line.set_color(candle.wick_down, bull ? settings.bull_wick : settings.bear_wick)
    candle
 
method Reorder(CandleSet candleSet, int offset) =>
    int size = candleSet.candles.size()
    if size > 0
        for i = size - 1 to 0
            Candle candle = candleSet.candles.get(i)
            if na(candle.body)
                candle.body := box.new(bar_index, 0.0, bar_index, 0.0, border_width = 1)
                candle.wick_up := line.new(bar_index, 0.0, bar_index, 0.0)
                candle.wick_down := line.new(bar_index, 0.0, bar_index, 0.0)
                candle.Style()
            int t_buffer = offset + (settings.width + settings.buffer) * (size - i - 1)
            box.set_lefttop(candle.body, bar_index + t_buffer, math.max(candle.o, candle.c))
            box.set_rightbottom(candle.body, bar_index + settings.width + t_buffer, math.min(candle.o, candle.c))
            int x = bar_index + settings.width / 2 + t_buffer
            line.set_xy1(candle.wick_up, x, candle.h)
            line.set_xy2(candle.wick_up, x, math.max(candle.o, candle.c))
            line.set_xy1(candle.wick_down, x, math.min(candle.o, candle.c))
            line.set_xy2(candle.wick_down, x, candle.l)
            if settings.daily_name
                if candle.dow == ''
                    int htf_s = timeframe.in_seconds(candleSet.settings.htf)
                    candle.dow := htf_s >= 2592000 ? str.format_time(candle.o_time + 28800000, 'MMM', TZ_NY) : htf_s >= 604800 ? str.format_time(candle.o_time + 28800000, 'dd', TZ_NY) : htf_s >= 86400 ? f_dow(dayofweek(candle.td, TZ_NY)) : htf_s < 3600 ? str.format_time(candle.o_time, 'm', TZ_NY) : str.format_time(candle.o_time, 'H', TZ_NY)
                if not na(candle.dow_label)
                    candle.dow_label.set_xy(bar_index + settings.width / 2 + t_buffer, candle.h)
                    candle.dow_label.set_text(candle.dow)
                else
                    candle.dow_label := label.new(bar_index + settings.width / 2 + t_buffer, candle.h, candle.dow, color=color_transparent, textcolor=settings.dow_color, style=label.style_label_down, size=settings.dow_size)
            if candle.sweeps.size() > 0
                for j = candle.sweeps.size() - 1 to 0
                    Sweep sweep = candle.sweeps.get(j)
                    if i == size - 1
                        if not na(sweep.htf_marker)
                            line.delete(sweep.htf_marker)
                        candle.sweeps.remove(j)
                        continue
                    if na(sweep.htf_marker)
                        sweep.htf_marker := line.new(bar_index - settings.width + t_buffer, sweep.price, bar_index + settings.width + t_buffer + 2, sweep.price, color=settings.sweep_color, style=ls_sweep, width=settings.sweep_width)
                    else
                        line.set_x1(sweep.htf_marker, bar_index - settings.width + t_buffer)
                        line.set_x2(sweep.htf_marker, bar_index + settings.width + t_buffer + 2)
        if settings.htf_label_show
            bool align = settings.label_alignment == 'Align'
            float top = align ? f_align_top(candleSet.candles) : f_set_high(candleSet.candles, 0.0)
            float bottom = align ? f_align_bot(candleSet.candles, top) : f_set_low(candleSet.candles, top)
            left = bar_index + offset + (settings.width + settings.buffer) * (size - 1) / 2
            string lbl = f_htfname(candleSet.settings.htf)
            string tmr = settings.htf_timer_show ? '(' + f_remaining(candleSet.settings.htf) + ')' : ''
            if settings.label_position == 'Both' or settings.label_position == 'Top'
                if not na(candleSet.tfNameTop)
                    candleSet.tfNameTop.set_xy(left, top)
                    candleSet.tfNameTop.set_text(lbl + (settings.htf_timer_show ? '\n' : '') + (settings.daily_name ? '\n' : ''))
                else
                    candleSet.tfNameTop := label.new(left, top, lbl + (settings.htf_timer_show ? '\n' : '') + (settings.daily_name ? '\n' : ''), color=color_transparent, textcolor=settings.htf_label_color, style=label.style_label_down, size=settings.htf_label_size)
                if settings.htf_timer_show
                    if not na(candleSet.tfTimerTop)
                        candleSet.tfTimerTop.set_xy(left, top)
                        candleSet.tfTimerTop.set_text(tmr + (settings.daily_name ? '\n' : ''))
                    else
                        candleSet.tfTimerTop := label.new(left, top, tmr + (settings.daily_name ? '\n' : ''), color=color_transparent, textcolor=settings.htf_timer_color, style=label.style_label_down, size=settings.htf_timer_size)
            if settings.label_position == 'Both' or settings.label_position == 'Bottom'
                if not na(candleSet.tfNameBottom)
                    candleSet.tfNameBottom.set_xy(left, bottom)
                    candleSet.tfNameBottom.set_text((settings.htf_timer_show ? '\n' : '') + lbl + (settings.daily_name ? '\n' : ''))
                else
                    candleSet.tfNameBottom := label.new(left, bottom, (settings.htf_timer_show ? '\n' : '') + lbl + (settings.daily_name ? '\n' : ''), color=color_transparent, textcolor=settings.htf_label_color, style=label.style_label_up, size=settings.htf_label_size)
                if settings.htf_timer_show
                    if not na(candleSet.tfTimerBottom)
                        candleSet.tfTimerBottom.set_xy(left, bottom)
                        candleSet.tfTimerBottom.set_text(tmr + (settings.daily_name ? '\n' : ''))
                    else
                        candleSet.tfTimerBottom := label.new(left, bottom, tmr + (settings.daily_name ? '\n' : ''), color=color_transparent, textcolor=settings.htf_timer_color, style=label.style_label_up, size=settings.htf_timer_size)
    candleSet
 
// FVG/VI use closed HTF candles only (index 1+). Rebuilds only when a new HTF candle forms; otherwise boxes shift with the bar delta.
method FindImbalance(CandleSet candleSet) =>
    if draw_now and (settings.fvg_show or settings.vi_show) and candleSet.candles.size() > 3
        if candleSet.imb_new
            for bx in candleSet.imbalances
                box.delete(bx)
            candleSet.imbalances.clear()
            if settings.fvg_show
                for i = 1 to candleSet.candles.size() - 3
                    Candle candle1 = candleSet.candles.get(i)
                    Candle candle2 = candleSet.candles.get(i + 2)
                    if candle1.l > candle2.h and math.min(candle1.o, candle1.c) > math.max(candle2.o, candle2.c)
                        candleSet.imbalances.push(box.new(box.get_left(candle2.body), candle2.h, box.get_right(candle1.body), candle1.l, bgcolor=settings.fvg_color, border_color=color_transparent, xloc=xloc.bar_index))
                    if candle1.h < candle2.l and math.max(candle1.o, candle1.c) < math.min(candle2.o, candle2.c)
                        candleSet.imbalances.push(box.new(box.get_right(candle1.body), candle1.h, box.get_left(candle2.body), candle2.l, bgcolor=settings.fvg_color, border_color=color_transparent))
            if settings.vi_show
                for i = 1 to candleSet.candles.size() - 2
                    Candle candle1 = candleSet.candles.get(i)
                    Candle candle2 = candleSet.candles.get(i + 1)
                    if candle1.l < candle2.h and math.min(candle1.o, candle1.c) > math.max(candle2.o, candle2.c)
                        candleSet.imbalances.push(box.new(box.get_left(candle2.body), math.min(candle1.o, candle1.c), box.get_right(candle1.body), math.max(candle2.o, candle2.c), bgcolor=settings.vi_color, border_color=color_transparent))
                    if candle1.h > candle2.l and math.max(candle1.o, candle1.c) < math.min(candle2.o, candle2.c)
                        candleSet.imbalances.push(box.new(box.get_right(candle1.body), math.min(candle2.o, candle2.c), box.get_left(candle2.body), math.max(candle1.o, candle1.c), bgcolor=settings.vi_color, border_color=color_transparent))
            candleSet.imb_new := false
            candleSet.imb_bar := bar_index
        else if candleSet.imb_bar != bar_index
            int dlt = bar_index - candleSet.imb_bar
            for bx in candleSet.imbalances
                box.set_left(bx, box.get_left(bx) + dlt)
                box.set_right(bx, box.get_right(bx) + dlt)
            candleSet.imb_bar := bar_index
    candleSet
 
method CheckSweeps(CandleSet candleSet) =>
    if settings.sweep_show and candleSet.candles.size() >= 3
        Candle curr_candle = candleSet.candles.get(0)
        Candle prev_candle = candleSet.candles.get(1)
        Candle candle_before_prev = candleSet.candles.get(2)

        if candleSet.new_ex
            bool bear_ok = settings.bias != "Bullish" and prev_candle.h > candle_before_prev.h and prev_candle.c < candle_before_prev.h and prev_candle.c >= candle_before_prev.l
            bool bull_ok = settings.bias != "Bearish" and prev_candle.l < candle_before_prev.l and prev_candle.c > candle_before_prev.l and prev_candle.c <= candle_before_prev.h

            if settings.sweep_alert
                if bear_ok
                    alert("Bearish Sweep Confirmed", alert.freq_once_per_bar)
                if bull_ok
                    alert("Bullish Sweep Confirmed", alert.freq_once_per_bar)

            if bear_ok
                Sweep sw = Sweep.new(na, true, curr_candle.o_time + candleSet.htf_ms, candle_before_prev.h)
                prev_candle.sweeps.push(sw)
                candleSet.active_sweeps.push(sw)

            if bull_ok
                Sweep sw = Sweep.new(na, false, curr_candle.o_time + candleSet.htf_ms, candle_before_prev.l)
                prev_candle.sweeps.push(sw)
                candleSet.active_sweeps.push(sw)

        if barstate.islast and settings.show_latest and candleSet.active_sweeps.size() > 0
            for i = candleSet.active_sweeps.size() - 1 to 0
                Sweep sw = candleSet.active_sweeps.get(i)
                if time > sw.end_idx
                    if not na(sw.htf_marker)
                        line.delete(sw.htf_marker)
                    candleSet.active_sweeps.remove(i)
                    for candle in candleSet.candles
                        int sweep_idx = candle.sweeps.indexof(sw)
                        if sweep_idx >= 0
                            candle.sweeps.remove(sweep_idx)
    candleSet

// Shared EQ logic (TTrades Fractal Model) used by T-Spot and Previous HTF EQ.
f_c2_eq(bool is_bull, float o, float c, float h, float l) =>
    bool with_swing = is_bull ? c > o : c < o
    float eq = (h + l) / 2
    if not with_swing
        eq := is_bull ? (c + l) / 2 : (c + h) / 2
    eq
 
method PrevEQ(CandleSet cs) =>
    Candle prv = cs.candles.get(1)
    float eq = (prv.h + prv.l) / 2
    if cs.candles.size() >= 3
        Candle c1 = cs.candles.get(2)
        bool bull_swing = prv.l < c1.l and prv.c > c1.l and settings.bias != "Bearish"
        bool bear_swing = prv.h > c1.h and prv.c < c1.h and settings.bias != "Bullish"
        if bull_swing and not bear_swing
            eq := f_c2_eq(true, prv.o, prv.c, prv.h, prv.l)
        else if bear_swing and not bull_swing
            eq := f_c2_eq(false, prv.o, prv.c, prv.h, prv.l)
    eq
 
