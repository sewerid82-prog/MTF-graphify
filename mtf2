//+--- Killzones (sessions) + Prev Day H/L                                                                  ---+//
//+------------------------------------------------------------------------------------------------------------+//
 
type Kz
    string title
    string sess
    color  col
    bool   on
    bool   prev
    array<box>   bx
    array<line>  hi
    array<line>  lo
    array<label> lh
    array<label> ll
    array<bool>  hv
    array<bool>  lv
 
type Pd
    string tf
    color  col
    bool   on
    bool   mid
    float  h
    float  l
    float  ph
    float  pl
    bool   hh
    bool   hw
    array<line>  ln
    array<label> lb
 
kz_new(string title, string sess, color col, bool on) =>
    Kz.new(title, sess, col, on, false, array.new_box(), array.new_line(), array.new_line(), array.new_label(), array.new_label(), array.new_bool(), array.new_bool())
 
pd_new(string tf, color col, bool on, bool mid) =>
    Pd.new(tf, col, on, mid, float(na), float(na), float(na), float(na), false, false, array.new_line(), array.new_label())
 
var array<Kz> kzs = array.new<Kz>()
var array<Pd> pds = array.new<Pd>()
var array<int> pd_ih  = array.new_int(1, na)
var array<int> pd_il  = array.new_int(1, na)
var array<int> pd_pih = array.new_int(1, na)
var array<int> pd_pil = array.new_int(1, na)
 
if barstate.isfirst
    kzs.push(kz_new(kz1_txt, kz1_ses, kz1_col, kz1_on))
    kzs.push(kz_new(kz2_txt, kz2_ses, kz2_col, kz2_on))
    kzs.push(kz_new(kz3_txt, kz3_ses, kz3_col, kz3_on))
    pds.push(pd_new('D', pd_d_col, pd_d_on, pd_d_mid))
 
bool kz_ok = tf_sec <= timeframe.in_seconds(kz_tf)
string kz_ls = f_ls(kz_style)
string pd_ls = f_ls(pd_style)
string kz_tz = settings.tbl_tz == 'Exchange' ? syminfo.timezone : settings.tbl_tz
 
kz_run(Kz k) =>
    bool t = k.on and kz_ok and in_win and not na(time('', k.sess, kz_tz))
    if k.on and kz_ok and in_win
        if t and (not k.prev or k.bx.size() == 0)
            color lc = color.new(k.col, 0)
            k.bx.unshift(box.new(bar_index, high, bar_index, low, border_color = kz_box ? k.col : na, bgcolor = kz_box ? k.col : na))
            if kz_piv
                k.hi.unshift(line.new(bar_index, high, bar_index, high, color = lc, style = kz_ls, width = kz_w))
                k.lo.unshift(line.new(bar_index, low, bar_index, low, color = lc, style = kz_ls, width = kz_w))
                k.hv.unshift(true)
                k.lv.unshift(true)
                if kz_lbl
                    k.lh.unshift(label.new(bar_index, high, k.title + ' High', style = label.style_label_left, color = color_transparent, textcolor = lc, size = kz_lsize))
                    k.ll.unshift(label.new(bar_index, low, k.title + ' Low', style = label.style_label_left, color = color_transparent, textcolor = lc, size = kz_lsize))
            while k.bx.size() > kz_max
                k.bx.pop().delete()
                if kz_piv
                    k.hi.pop().delete()
                    k.lo.pop().delete()
                    k.hv.pop()
                    k.lv.pop()
                    if kz_lbl
                        k.lh.pop().delete()
                        k.ll.pop().delete()
        if k.bx.size() > 0
            for i = 0 to k.bx.size() - 1
                if t and i == 0
                    box b = k.bx.get(0)
                    b.set_right(bar_index)
                    b.set_top(math.max(b.get_top(), high))
                    b.set_bottom(math.min(b.get_bottom(), low))
                    if kz_piv
                        line hl_ = k.hi.get(0)
                        hl_.set_x2(bar_index)
                        if high > hl_.get_y1()
                            hl_.set_xy1(bar_index, high)
                            hl_.set_xy2(bar_index, high)
                        line ll_ = k.lo.get(0)
                        ll_.set_x2(bar_index)
                        if low < ll_.get_y1()
                            ll_.set_xy1(bar_index, low)
                            ll_.set_xy2(bar_index, low)
                        if kz_lbl
                            k.lh.get(0).set_xy(bar_index, hl_.get_y1())
                            k.ll.get(0).set_xy(bar_index, ll_.get_y1())
                else if kz_piv
                    // Unbroken pivots are only stretched on the last bar; a break fixes the end at the break bar.
                    if k.hv.get(i)
                        line hl_ = k.hi.get(i)
                        bool brk_h = high > hl_.get_y1()
                        if brk_h or barstate.islast
                            hl_.set_x2(bar_index)
                            if kz_lbl
                                k.lh.get(i).set_x(bar_index)
                        if brk_h
                            k.hv.set(i, false)
                            if kz_alert and i == 0
                                alert('Broke ' + k.title + ' High', alert.freq_once_per_bar)
                    if k.lv.get(i)
                        line ll_ = k.lo.get(i)
                        bool brk_l = low < ll_.get_y1()
                        if brk_l or barstate.islast
                            ll_.set_x2(bar_index)
                            if kz_lbl
                                k.ll.get(i).set_x(bar_index)
                        if brk_l
                            k.lv.set(i, false)
                            if kz_alert and i == 0
                                alert('Broke ' + k.title + ' Low', alert.freq_once_per_bar)
    k.prev := t
 
bool pd_nw_d = timeframe.change('D')
 
// Period high/low state is tracked on all bars (cheap); lines/labels are only drawn inside the history window.
// Live lines are stretched only on the last bar, on a hit, or when their period rolls over.
pd_run(Pd d, bool nw) =>
    if d.on and kz_ok
        int c = d.mid ? 3 : 2
        int k = 0
        bool roll = nw or na(d.h)
        if roll
            if in_win and d.ln.size() >= c
                for j = 0 to c - 1
                    bool frozen = (j == 0 and d.hh) or (j == 1 and d.hw)
                    if not frozen
                        d.ln.get(j).set_x2(bar_index - 1)
                        d.lb.get(j).set_x(bar_index - 1)
            pd_pih.set(k, pd_ih.get(k))
            pd_pil.set(k, pd_il.get(k))
            d.ph := d.h
            d.pl := d.l
            d.h := high
            d.l := low
            d.hh := false
            d.hw := false
            pd_ih.set(k, bar_index)
            pd_il.set(k, bar_index)
        else
            if high > d.h
                pd_ih.set(k, bar_index)
            if low < d.l
                pd_il.set(k, bar_index)
            d.h := math.max(high, d.h)
            d.l := math.min(low, d.l)
        if in_win and not na(d.ph) and (roll or d.ln.size() == 0)
            int xh = pd_pih.get(k)
            int xl = pd_pil.get(k)
            if not roll
                d.hh := d.h > d.ph
                d.hw := d.l < d.pl
            color lc = color.new(d.col, 0)
            string p = 'P' + d.tf
            if d.mid
                float m = (d.ph + d.pl) / 2
                d.ln.unshift(line.new(bar_index, m, bar_index, m, color = d.col, style = pd_ls, width = pd_w))
                d.lb.unshift(label.new(bar_index, m, p + 'M', style = label.style_label_left, color = color_transparent, textcolor = lc, size = pd_lsize))
            d.ln.unshift(line.new(na(xl) ? bar_index : xl, d.pl, bar_index, d.pl, color = d.col, style = pd_ls, width = pd_w))
            d.lb.unshift(label.new(bar_index, d.pl, p + 'L', style = label.style_label_left, color = color_transparent, textcolor = lc, size = pd_lsize))
            d.ln.unshift(line.new(na(xh) ? bar_index : xh, d.ph, bar_index, d.ph, color = d.col, style = pd_ls, width = pd_w))
            d.lb.unshift(label.new(bar_index, d.ph, p + 'H', style = label.style_label_left, color = color_transparent, textcolor = lc, size = pd_lsize))
            while d.ln.size() > pd_max * c
                d.ln.pop().delete()
                d.lb.pop().delete()
        if in_win and d.ln.size() >= c
            bool hitH = not d.hh and high > d.ln.get(0).get_y1()
            bool hitL = not d.hw and low < d.ln.get(1).get_y1()
            for j = 0 to c - 1
                bool frozen = (j == 0 and d.hh) or (j == 1 and d.hw)
                if not frozen and (barstate.islast or (j == 0 and hitH) or (j == 1 and hitL))
                    d.ln.get(j).set_x2(bar_index)
                    d.lb.get(j).set_x(bar_index)
            if hitH
                d.hh := true
                if pd_alert
                    alert('Hit P' + d.tf + 'H', alert.freq_once_per_bar)
            if hitL
                d.hw := true
                if pd_alert
                    alert('Hit P' + d.tf + 'L', alert.freq_once_per_bar)
 
if in_win and kz_ok
    for k in kzs
        kz_run(k)
pd_run(pds.get(0), pd_nw_d)

// ===== Chart FVG/VI logic =====
var array<box>  cfFx = array.new<box>()
var array<bool> cfFu = array.new<bool>()
var array<bool> cfFd = array.new<bool>()
var array<box>  cfVx = array.new<box>()
var array<bool> cfVu = array.new<bool>()
var array<bool> cfVd = array.new<bool>()

// Bars to next HTF open (computed by CalcNext for the T-Spot HTF), last bar only.
int cf_nx = barstate.islast and ts_target > 0 ? sets.get(ts_target - 1).nxt_bars : 0

// Sweep check, new boxes, trim to n.
cf_run(array<box> bx, array<bool> bu, array<bool> dn, int n, int lft, color cb, color cr, bool nb, float tb, float bb, bool nr, float tr, float br) =>
    if bx.size() > 0
        for i = bx.size() - 1 to 0
            if not dn.get(i)
                box b = bx.get(i)
                if bu.get(i) ? low <= (b.get_top() + b.get_bottom()) / 2 : high >= (b.get_top() + b.get_bottom()) / 2
                    if cf_keep
                        dn.set(i, true)
                        b.set_right(bar_index)
                    else
                        b.delete()
                        bx.remove(i)
                        bu.remove(i)
                        dn.remove(i)
    if nb
        bx.push(box.new(bar_index - lft, tb, bar_index, bb, border_color = na, bgcolor = cb))
        bu.push(true)
        dn.push(false)
    if nr
        bx.push(box.new(bar_index - lft, tr, bar_index, br, border_color = na, bgcolor = cr))
        bu.push(false)
        dn.push(false)
    while bx.size() > n
        bx.shift().delete()
        bu.shift()
        dn.shift()

// Stretch unswept boxes to next HTF open (last bar).
cf_ext(array<box> bx, array<bool> bu, array<bool> dn) =>
    if bx.size() > 0
        for i = 0 to bx.size() - 1
            if not dn.get(i)
                box b = bx.get(i)
                bool hit = bu.get(i) ? low <= (b.get_top() + b.get_bottom()) / 2 : high >= (b.get_top() + b.get_bottom()) / 2
                b.set_right(hit ? bar_index : bar_index + cf_nx)

float cf_bo  = math.min(open, close)
float cf_to  = math.max(open, close)
float cf_bo1 = math.min(open[1], close[1])
float cf_to1 = math.max(open[1], close[1])

if in_win and barstate.isconfirmed
    if cf_fvg
        cf_run(cfFx, cfFu, cfFd, cf_fvgN, 2, cf_fvgB, cf_fvgR, low > high[2], low, high[2], high < low[2], low[2], high)
    if cf_vi
        cf_run(cfVx, cfVu, cfVd, cf_viN, 1, cf_viB, cf_viR, cf_bo > cf_to1 and low < high[1], cf_bo, cf_to1, cf_to < cf_bo1 and high > low[1], cf_bo1, cf_to)

if barstate.islast
    cf_ext(cfFx, cfFu, cfFd)
    cf_ext(cfVx, cfVu, cfVd)

