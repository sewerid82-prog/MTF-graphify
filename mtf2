f_ls(string style) =>
    switch style
        'Solid' => line.style_solid
        'Dashed' => line.style_dashed
        'Dotted' => line.style_dotted
        => line.style_solid
 
f_dow(int index) =>
    switch index
        1 => 'M'
        2 => 'T'
        3 => 'W'
        4 => 'T'
        5 => 'F'
        6 => 'S'
        7 => 'S'
        => ''
 
f_valid_tf(string HTF) =>
    int s1 = timeframe.in_seconds()
    int s2 = timeframe.in_seconds(HTF)
    if s2 >= 86400 and s2 > s1
        true
    else
        s1 < s2 and math.round(s2 / s1) == s2 / s1
 
f_remaining(string HTF) =>
    if barstate.isrealtime
        timeRemaining = (time_close(HTF) - timenow) / 1000
        days = math.floor(timeRemaining / 86400)
        hours = math.floor((timeRemaining - days * 86400) / 3600)
        minutes = math.floor((timeRemaining - days * 86400 - hours * 3600) / 60)
        seconds = math.floor(timeRemaining - days * 86400 - hours * 3600 - minutes * 60)
        r = str.tostring(seconds, '00')
        if minutes > 0 or hours > 0 or days > 0
            r := str.tostring(minutes, '00') + ':' + r
        if hours > 0 or days > 0
            r := str.tostring(hours, '00') + ':' + r
        if days > 0
            r := str.tostring(days) + 'D ' + r
        r
    else
        'n/a'
 
f_htfname(string HTF) =>
    formatted = HTF
    seconds = timeframe.in_seconds(HTF)
    if seconds < 60
        formatted := str.tostring(seconds) + 's'
    else if seconds / 60 < 60
        formatted := str.tostring(seconds / 60) + 'm'
    else if seconds / 60 / 60 < 24
        formatted := str.tostring(seconds / 60 / 60) + 'H'
    formatted
 
f_set_high(array<Candle> candles, float h) =>
    float _h = h
    for c in candles
        if c.h > _h
            _h := c.h
    _h
 
f_set_low(array<Candle> candles, float l) =>
    float _l = l
    for c in candles
        if c.l < _l
            _l := c.l
    _l
 
f_align_top(array<Candle> candles) =>
    float h = 0.0
    for cs in active
        h := f_set_high(cs.candles, h)
    f_set_high(candles, h)
 
f_align_bot(array<Candle> candles, float top) =>
    float l = top
    for cs in active
        l := f_set_low(cs.candles, l)
    f_set_low(candles, l)
 
